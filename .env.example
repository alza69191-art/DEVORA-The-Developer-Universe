# Copy to .env.local for local development; set real values in provider secret settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000

# Neon is the preferred PostgreSQL-compatible primary candidate.
# TiDB PostgreSQL-compatible is experimental only; never configure both as primary.
# DATABASE_URL is the single active connection string.

# Forgejo: deploy on a separate host with persistent volumes.
FORGEJO_BASE_URL=https://git.example.com
FORGEJO_OWNER=devora-service
FORGEJO_API_TOKEN=

# Resend transactional email (verification and password recovery).
RESEND_API_KEY=
EMAIL_FROM=DEVORA <noreply@example.com>

# Cloudflare R2 object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devora-assets
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

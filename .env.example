# Required for Render and local production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# Forgejo runs on a persistent VM, not on Render's ephemeral filesystem
FORGEJO_BASE_URL=http://localhost:3001
FORGEJO_API_TOKEN=

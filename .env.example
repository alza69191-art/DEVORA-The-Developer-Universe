# Copy to .env.local for local development; set real values in provider secret settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
APP_URL=http://localhost:3000

# Neon is the preferred PostgreSQL-compatible primary candidate.
# TiDB PostgreSQL-compatible is experimental only; never configure both as primary.
# DATABASE_URL is the single active connection string.

# Forgejo: separate persistent host, not Render ephemeral disk.
FORGEJO_BASE_URL=https://git.example.com
FORGEJO_API_TOKEN=

# Optional Cloudflare R2 (S3-compatible object storage) for uploads/LFS artifacts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=devora-assets
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# Optional SMTP provider for verification and recovery emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DEVORA <noreply@example.com>
